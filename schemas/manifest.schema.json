{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulfbou.github.io/aws-learning-curve/schemas/manifest.schema.json",
  "title": "Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "content_version",
    "default_language",
    "generated_at",
    "collections",
    "published_bundle",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "content_version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"
    },
    "default_language": {
      "$ref": "common.schema.json#/$defs/bcp47"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "collections": {
      "type": "object",
      "required": [
        "sources",
        "concepts",
        "competencies",
        "learning_units",
        "questions",
        "scenarios",
        "procedures",
        "misconceptions"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "published_bundle": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "manifest_path": {
          "type": "string"
        }
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/id"
      }
    }
  },
  "additionalProperties": true
}