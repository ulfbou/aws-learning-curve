{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulfbou.github.io/aws-learning-curve/schemas/learning-transaction.schema.json",
  "title": "Bounded learning artifact transaction",
  "type": "object",
  "required": ["schema_version", "learning_goal", "operations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "learning_goal": {"type": "string", "minLength": 1},
    "context_created_from": {"type": "string"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "id", "kind"],
        "properties": {
          "action": {"enum": ["create", "update", "unchanged"]},
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+){1,10}$"},
          "kind": {"enum": ["concept", "competency", "learning_unit", "question", "scenario", "procedure", "misconception"]},
          "expected_revision": {"type": "integer", "minimum": 1},
          "expected_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content": {"type": "object"}
        },
        "allOf": [
          {"if": {"properties": {"action": {"const": "update"}}}, "then": {"required": ["expected_revision", "expected_content_hash", "content"]}},
          {"if": {"properties": {"action": {"const": "create"}}}, "then": {"required": ["content"]}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
