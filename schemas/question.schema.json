{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ulfbou.github.io/aws-learning-curve/schemas/question.schema.json",
  "title": "Question",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "status",
    "domain",
    "question_type",
    "difficulty",
    "language",
    "prompt",
    "revision",
    "created_at",
    "updated_at",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "question"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "domain": {
      "$ref": "common.schema.json#/$defs/domain"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "multiple_select",
        "true_false",
        "classification",
        "matching",
        "ordering",
        "fill_blank",
        "short_answer",
        "explain_difference",
        "diagnose_scenario",
        "recommend_solution",
        "reflection",
        "self_assessment"
      ]
    },
    "difficulty": {
      "type": "string"
    },
    "cognitive_level": {
      "type": "string"
    },
    "language": {
      "$ref": "common.schema.json#/$defs/bcp47"
    },
    "prompt": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "competency_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "concept_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "misconception_detection": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scoring": {
      "type": "object"
    },
    "feedback": {
      "type": "object"
    },
    "variation": {
      "type": "object",
      "properties": {
        "allow_llm_variants": {
          "type": "boolean"
        },
        "invariant_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/contentHash"
    },
    "aliases": {
      "$ref": "common.schema.json#/$defs/aliases"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "grounding": {
      "$ref": "common.schema.json#/$defs/grounding"
    }
  },
  "additionalProperties": false
}